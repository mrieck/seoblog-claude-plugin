# FOR DEVELOPING THIS PLUGIN, NOT FOR USING IT.
#
# An installed plugin lives in a version-pinned cache directory, so a .env
# written there is orphaned on every update. Store real keys where they
# survive updates — resolution order (first hit wins):
#
#   1. environment            export FAL_API_KEY=... (or ~/.claude/settings.json "env")
#   2. macOS Keychain         security add-generic-password -s seoblog -a FAL_API_KEY -w
#                             security add-generic-password -s seoblog -a "site:<id>" -w
#   3. ~/.config/seoblog/config.json
#   4. this .env              (a checkout of this repo only)

# fal.ai key — enables hero/inline/OG image generation. https://fal.ai/dashboard/keys
FAL_API_KEY=

# Per-site blog API key(s): SEOBLOG_SITE_<ID>_API_KEY where <ID> is the site id
# from ~/.config/seoblog/config.json, uppercased, non-alphanumerics -> _.
SEOBLOG_SITE_PLUGMYPLUGIN_API_KEY=
